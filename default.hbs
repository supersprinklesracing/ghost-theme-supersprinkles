<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    {{ghost_head}}
</head>
<body class="{{body_class}}">

    <header class="site-header">
        <a class="site-logo" href="{{@site.url}}">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}" style="max-height:40px;">
            {{else}}
                {{@site.title}}
            {{/if}}
        </a>
        <nav class="site-nav">
            {{navigation}}
        </nav>
    </header>

    <main class="site-wrapper">
        {{{body}}}
    </main>

    <footer class="site-footer">
        <p>&copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>. Super Sprinkles Racing. All rights reserved.</p>
        <p>Built for Speed. Fueled by Sprinkles.</p>
    </footer>

    {{ghost_foot}}
</body>
</html>
