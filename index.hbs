{{!< default}}

<div class="site-hero">
    <h1>Super Sprinkles Racing</h1>
    <p>We ride fast. We eat sprinkles. Join the revolution.</p>
</div>

<div class="post-feed">
    {{#foreach posts}}
        <article class="post-card">
            {{#if feature_image}}
                <a href="{{url}}">
                    <img class="post-card-image"
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w"
                        sizes="(max-width: 1000px) 400px, 800px"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{title}}"
                        loading="lazy"
                    />
                </a>
            {{/if}}
            <div class="post-card-content">
                {{#primary_tag}}
                    <div class="post-card-tag">{{name}}</div>
                {{/primary_tag}}
                <h2 class="post-card-title"><a href="{{url}}">{{title}}</a></h2>
                <div class="post-card-excerpt">{{excerpt words="30"}}...</div>
                <div class="post-card-meta">
                    <span>{{date format="MMM D, YYYY"}}</span>
                    <span>{{reading_time}}</span>
                </div>
            </div>
        </article>
    {{/foreach}}
</div>

{{pagination}}
